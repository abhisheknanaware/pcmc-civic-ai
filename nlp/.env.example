HF_TOKEN=

# Local Ollama model for officer replies and the citizen chatbot (fits fully on an 8 GB GPU)
REPLY_MODEL=qwen3:8b

# Weekly knowledge-base refresh (0 = off) and the hour its night window starts
KB_REFRESH_DAYS=7
KB_REFRESH_HOUR=2
# Only needed when the backend runs on another host/container (Docker)
INTERNAL_API_TOKEN=
