# Copy to .env (same folder as docker-compose.yml) and fill in. Never commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
INTERNAL_API_TOKEN=

# Optional
WEB_PORT=8080
FRONTEND_URL=http://localhost:8080
REPLY_MODEL=qwen3:8b
RETENTION_DAYS=365
KB_REFRESH_DAYS=7
KB_REFRESH_HOUR=2
HF_TOKEN=

# Email notifications (Gmail: use an app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Citizen photo storage
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
