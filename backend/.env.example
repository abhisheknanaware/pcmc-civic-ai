PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/complaint-ai
JWT_SECRET=change-me-to-a-long-random-string
NLP_SERVICE_URL=http://localhost:8000/process
GEMINI_API_KEY=
OPENAI_API_KEY=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
# Local Ollama model for officer replies and the citizen chatbot (fits fully on an 8 GB GPU)
REPLY_MODEL=qwen3:8b

# Session length for officers, and days after closing before a complaint is anonymised
JWT_EXPIRES_IN=8h
RETENTION_DAYS=365
# Only needed when the NLP service runs on another host/container (Docker)
INTERNAL_API_TOKEN=
